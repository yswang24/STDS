# 数据
DB_PATH=/absolute/path/to/stms.db
PART_WEIGHT_XLSX_PATH=/absolute/path/to/part-weight.xlsx

# LLM 后端:auto / vllm / deepseek / ark / custom / ollama / mock
LLM_BACKEND=deepseek
CONCURRENCY_LIMIT=8
MAX_TOKENS=4096

# 向量后端与聊天后端独立:auto / vllm / ark / custom / ollama / mock
EMBED_BACKEND=auto

# DeepSeek 官方 OpenAI 兼容 API
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-请替换为你的密钥
DEEPSEEK_LLM_MODEL=deepseek-v4-flash

# 可选：火山引擎方舟。推理只使用一个 Ark Bearer API Key；
# 模型字段可填 Model ID 或 ep- 开头的 Endpoint ID。
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_LLM_MODEL=
# 可选独立向量 Key；留空时复用 ARK_API_KEY。
ARK_EMBED_API_KEY=
ARK_EMBED_MODEL=
# text 调 /embeddings（单批最多 256）；multimodal 调 /embeddings/multimodal。
ARK_EMBED_MODE=text

# 可选：vLLM
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_LLM_MODEL=qwen3-14b
VLLM_EMBED_BASE_URL=
VLLM_EMBED_MODEL=qwen3-embedding

# 可选：其他 OpenAI 兼容 API
CUSTOM_API_BASE_URL=http://localhost:9000/v1
CUSTOM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_EMBED_MODEL=
CUSTOM_API_EXTRA_HEADERS=

# 可选：Ollama
OLLAMA_BASE=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:14b
EMBED_MODEL=qwen3-embedding:8b
